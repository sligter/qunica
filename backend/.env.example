# Copy to .env for local development.
# Defaults match docker-compose.dev.yml.

DATABASE_URL=postgresql+asyncpg://agentchat:agentchat@localhost:5432/agentchat
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agentchat

SECRET_KEY=please-change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DEBUG=true

CORS_ORIGINS=["http://localhost:5173"]

# LLM defaults — agent-level llm_config can override per call.
# For OpenAI: https://api.openai.com/v1
# For Xiaomi MiMo (test): see llm_config-for-test.txt
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=gpt-4o-mini
