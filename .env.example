# Copy to .env only when running the legacy Python oracle stack.
# These Docker/Postgres/MinIO values are used by docker-compose.dev.yml and
# the legacy backend/ parity oracle. They are not required by the normal Rust
# desktop runtime.

POSTGRES_USER=agentchat
POSTGRES_PASSWORD=agentchat
POSTGRES_DB=agentchat

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
